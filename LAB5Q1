from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import rsa, padding

# Step 1: Create a sample text file and write content to it
file_name = "CRYPTO.txt"
file_content = b"Message for RSA signing stored in a text file."

with open(file_name, "wb") as f:
    f.write(file_content)

# Step 2: RSA key pair generation
private_key = rsa.generate_private_key(
    public_exponent=65537,
    key_size=2048
)
public_key = private_key.public_key()

# Step 3: Read message contents from the text file
with open(file_name, "rb") as f:
    message = f.read()

# Step 4: Sign the message using PKCS1v15 padding and SHA-256[cite: 2, 4]
signature = private_key.sign(
    message,
    padding.PKCS1v15(),
    hashes.SHA256()
)

# Report the Hexadecimal Signature[cite: 4]
print("Hexadecimal Signature:", signature.hex())

# Step 5: Verify the signature[cite: 2, 4]
try:
    public_key.verify(
        signature,
        message,
        padding.PKCS1v15(),
        hashes.SHA256()
    )
    print("Verification successful")
except Exception as e:
    print("Verification failed:", e)